# =====================================================================
#  English Reading Project — security headers (Apache / cPanel)
#  Requires mod_headers (enabled on most cPanel hosts).
# =====================================================================

Options -Indexes

# Source/backup archives must never be downloadable from the public site.
<FilesMatch "\.(zip|rar|7z|bak|psd|ai)$">
  Require all denied
</FilesMatch>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Cross-Origin-Opener-Policy "same-origin-allow-popups"
  Header always set Permissions-Policy "camera=(self), microphone=(), geolocation=(), payment=(), usb=(), fullscreen=(self \"https://app.artistly.ai\"), autoplay=(self \"https://app.artistly.ai\")"

  # Weekly Readings still uses inline <style>/<script> and html2canvas from its CDN,
  # so this site-wide policy allows 'unsafe-inline'. Little Readers has a stricter
  # policy in little-readers/.htaccess.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://html2canvas.hertzen.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob:; media-src 'self' blob:; connect-src 'self'; frame-src https://app.artistly.ai; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; object-src 'none'"

  # HSTS only when the site is served over HTTPS.
  <If "%{HTTPS} == 'on'">
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  </If>

  # Scripts, styles and the Little Readers links file: the browser must check
  # for a newer version on every visit (fast 304 when nothing changed).
  <FilesMatch "\.(js|css|json)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
